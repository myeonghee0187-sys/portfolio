# Contact form (Vercel Serverless Function /api/contact). Server-side only — never prefix with VITE_.
# Set these in Vercel → Project → Settings → Environment Variables. Do not commit a real .env file.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=

# Sender address. Must be on a domain verified in Resend, e.g. "Portfolio <contact@your-domain.com>".
# Without a verified domain, "Portfolio <onboarding@resend.dev>" only delivers to the Resend account's own email.
CONTACT_FROM_EMAIL=
